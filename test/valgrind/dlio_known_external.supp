# Suppressions for known false positives when running dlio_benchmark under Valgrind.
# All contexts here are in third-party libraries (glibc dynamic linker, TensorFlow/protobuf)
# and are not DFTracer or dlio_benchmark bugs.

# ── glibc dynamic linker ──────────────────────────────────────────────────────
# strncmp (SSE/AVX SIMD) reads past the end of a strdup'd RPATH segment.
# This is a known false positive in the glibc ld.so RPATH parser:
#   https://sourceware.org/bugzilla/show_bug.cgi?id=14271
{
   glibc_dl_load_rpath_strncmp_invalid_read
   Memcheck:Addr16
   fun:strncmp
   fun:is_dst
   fun:_dl_dst_count
   fun:expand_dynamic_string_token
   fun:fillin_rpath
   fun:decompose_rpath*
   fun:cache_rpath
   fun:_dl_map_object
}

{
   glibc_dl_load_rpath_dst_substitute_invalid_read
   Memcheck:Addr16
   fun:strncmp
   fun:is_dst
   fun:_dl_dst_substitute
   fun:fillin_rpath
   fun:decompose_rpath*
   fun:cache_rpath
   fun:_dl_map_object
}

# ── TensorFlow / protobuf ─────────────────────────────────────────────────────
# protobuf DescriptorPool::Tables::CreateFlatAlloc allocates a large block
# via operator new and intentionally leaves padding bytes uninitialised before
# placement-constructing typed sub-allocations into it.  This manifests as
# uninitialised-value warnings deep inside the descriptor-building path during
# TensorFlow's static-initialisation routines.
{
   tensorflow_protobuf_flatalloc_uninit_libtensorflow_framework
   Memcheck:Cond
   fun:_ZN6google8protobuf17DescriptorBuilder24BuildFieldOrExtensionERKNS0_20FieldDescriptorProtoEPNS0_10DescriptorEPNS0_15FieldDescriptorEbRNS0_8internal13FlatAllocatorE
   fun:_ZN6google8protobuf17DescriptorBuilder12BuildMessageERKNS0_15DescriptorProtoEPKNS0_10DescriptorEPS5_RNS0_8internal13FlatAllocatorE
   fun:_ZN6google8protobuf17DescriptorBuilder13BuildFileImplERKNS0_19FileDescriptorProtoERNS0_8internal13FlatAllocatorE
   fun:_ZN6google8protobuf17DescriptorBuilder9BuildFileERKNS0_19FileDescriptorProtoE
   obj:*/tensorflow/libtensorflow_framework.so*
}

{
   tensorflow_protobuf_flatalloc_uninit_pywrap_profiler
   Memcheck:Cond
   fun:_ZN6google8protobuf17DescriptorBuilder24BuildFieldOrExtensionERKNS0_20FieldDescriptorProtoEPNS0_10DescriptorEPNS0_15FieldDescriptorEbRNS0_8internal13FlatAllocatorE
   fun:_ZN6google8protobuf17DescriptorBuilder12BuildMessageERKNS0_15DescriptorProtoEPKNS0_10DescriptorEPS5_RNS0_8internal13FlatAllocatorE
   fun:_ZN6google8protobuf17DescriptorBuilder13BuildFileImplERKNS0_19FileDescriptorProtoERNS0_8internal13FlatAllocatorE
   fun:_ZN6google8protobuf17DescriptorBuilder9BuildFileERKNS0_19FileDescriptorProtoE
   obj:*/_pywrap_profiler_plugin.so*
}

# Broad catch-all for any other TensorFlow shared object triggering the same
# protobuf uninitialised-value pattern during static init via dl_init.
{
   tensorflow_protobuf_flatalloc_uninit_dl_init
   Memcheck:Cond
   fun:_ZN6google8protobuf17DescriptorBuilder24BuildFieldOrExtensionERKNS0_20FieldDescriptorProtoEPNS0_10DescriptorEPNS0_15FieldDescriptorEbRNS0_8internal13FlatAllocatorE
   ...
   fun:call_init*
   fun:_dl_init
}

# ── MPI / PMIx / OpenMPI init ─────────────────────────────────────────────────
# MPI startup routinely leaves uninitialised bytes in PMIx, hwloc, and UCX
# internal structures.  None of these involve DFTracer.
{
   mpi_pmix_uninit
   Memcheck:Cond
   ...
   obj:*/libmpi*.so*
}
{
   mpi_pmix_value_uninit
   Memcheck:Value8
   ...
   obj:*/libmpi*.so*
}
{
   pmix_uninit
   Memcheck:Cond
   ...
   obj:*/libpmix*.so*
}
{
   ucx_uninit
   Memcheck:Cond
   ...
   obj:*/libucp*.so*
}
{
   ucx_value_uninit
   Memcheck:Value8
   ...
   obj:*/libucp*.so*
}
{
   hwloc_uninit
   Memcheck:Cond
   ...
   obj:*/libhwloc*.so*
}

# ── NumPy / BLAS ──────────────────────────────────────────────────────────────
# NumPy and OpenBLAS use SIMD intrinsics that read/write beyond the logical
# array boundary for alignment; these are intentional and not DFTracer bugs.
{
   numpy_simd_invalid_read8
   Memcheck:Addr8
   ...
   obj:*/numpy/core/*.so*
}
{
   openblas_simd_invalid_read16
   Memcheck:Addr16
   ...
   obj:*/libopenblas*.so*
}
{
   openblas_simd_invalid_read8
   Memcheck:Addr8
   ...
   obj:*/libopenblas*.so*
}

# ── Python interpreter startup ────────────────────────────────────────────────
# CPython intentionally allocates arenas with malloc and then sub-allocates
# from them without zero-initialising padding; this shows up as leak noise
# in Python 3.11+ arena allocators.
{
   python_pymalloc_arena_leak
   Memcheck:Leak
   match-leak-kinds: reachable
   fun:malloc
   ...
   fun:_PyObject_Malloc
}
{
   python_pyarena_leak
   Memcheck:Leak
   match-leak-kinds: reachable
   ...
   obj:*/libpython3*.so*
}

# ── Flux / PMI launcher ───────────────────────────────────────────────────────
# The Flux process manager and shell inherit file descriptors from the broker
# that are outside the Valgrind-tracked range; the resulting close() warnings
# are harmless noise.  (Valgrind Warning: messages cannot be suppressed via
# this file, but the corresponding error-class suppressions are kept here for
# documentation purposes.)
{
   flux_pmi_fd_leak
   Memcheck:Leak
   match-leak-kinds: reachable
   ...
   obj:*/libflux*.so*
}

# ── CUDA / NVML runtime ───────────────────────────────────────────────────────
# CUDA driver initialisation uses SIMD and partial loads that are reported
# as false positives.
{
   cuda_driver_init_cond
   Memcheck:Cond
   ...
   obj:*/libcuda*.so*
}
{
   cuda_driver_init_value
   Memcheck:Value8
   ...
   obj:*/libcuda*.so*
}
{
   nvml_init_cond
   Memcheck:Cond
   ...
   obj:*/libnvidia*.so*
}

# ── h5py / HDF5 ───────────────────────────────────────────────────────────────
# HDF5 metadata caches and chunk B-tree structures leave padding uninitialised.
{
   hdf5_metadata_uninit
   Memcheck:Cond
   ...
   obj:*/libhdf5*.so*
}
{
   h5py_uninit
   Memcheck:Cond
   ...
   obj:*/h5py/*.so*
}
